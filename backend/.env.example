APP_SERVICE_NAME="Diabetes Mellitus Prediction"
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text

# Copie para backend/.env e escolha uma versão existente no Model Registry.
APP_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
APP_MLFLOW_MODEL_NAME=niddk-diabetes-xgboost
APP_MLFLOW_MODEL_VERSION=5
