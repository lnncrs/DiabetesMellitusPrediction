APP_SERVICE_NAME="Diabetes Mellitus Prediction"
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text

# Use "latest" para carregar a versão mais recente no Model Registry durante a inicialização.
# Também é possível informar uma versão inteira positiva específica.
APP_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
APP_MLFLOW_MODEL_NAME=niddk-diabetes-xgboost
APP_MLFLOW_MODEL_VERSION=latest
